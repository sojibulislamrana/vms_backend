# ==============================================================================
# Database Configuration Template (Stark Group VMS Backend)
# Copy this file to .env or export these variables in your terminal/CI environment.
# NEVER commit your real .env file or database credentials to Git!
# ==============================================================================

# Database JDBC Connection URL
# For PostgreSQL:
# DB_URL=jdbc:postgresql://localhost:5432/vms_db
# For SQLite (default for zero-setup local dev):
DB_URL=jdbc:sqlite:vms.db

# Database Credentials
DB_USERNAME=
DB_PASSWORD=

# Driver Class Name (Auto-detected for most databases, or specify explicitly)
# For PostgreSQL: org.postgresql.Driver
# For SQLite: org.sqlite.JDBC
DB_DRIVER=org.sqlite.JDBC

# JPA / Hibernate Dialect & DDL
# For PostgreSQL: org.hibernate.dialect.PostgreSQLDialect
# For SQLite: org.hibernate.community.dialect.SQLiteDialect
JPA_DATABASE_PLATFORM=org.hibernate.community.dialect.SQLiteDialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Server Port (Render injects PORT automatically)
PORT=8080

# CORS Allowed Origins for production deployment (comma-separated domains)
# Example for Render: CORS_ALLOWED_ORIGINS=https://vms-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://*.onrender.com

